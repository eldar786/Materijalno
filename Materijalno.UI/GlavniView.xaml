<UserControl x:Class="Materijalno.UI.GlavniView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Materijalno.UI"
             xmlns:vm="clr-namespace:Materijalno.ViewModel;assembly=Materijalno.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate DataType="{x:Type vm:GlavniViewModel}">
            <local:GlavniView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SifarnikSkladistaViewModel}">
            <local:SifarnikSkladista/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SifarnikSkladistaFormViewModel}">
            <local:SifarnikSkladistaForm/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SifarnikMaterijalSkladisteKontoFormViewModel}">
            <local:SifarnikMaterijalSkladisteKontoForm/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SifarnikKontaFormViewModel}">
            <local:SifarnikKontaForm/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:UnosInventurnogStanjaViewModel}">
            <local:UnosInventurnogStanja/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NaloziZaFinansijePrintanjeNalogaViewModel}">
            <local:NaloziZaFinansijePrintanjeNaloga/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PostavkaNovogPocetnogstanjaViewModel}">
            <local:PostavkaNovogPocetnogstanja/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PocetnoStanjePrviPutViewModel}">
            <local:PocetnoStanjePrviPut/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StampanjeInventurnihZalihaViewModel}">
            <local:StampanjeInventurnihZaliha/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StampanjeInventurnihListicaViewModel}">
            <local:StampanjeInventurnihListica/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PovratUSkladisteViewModel}">
            <local:PovratUSkladiste/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NaloziMedjuskladisnicaViewModel}">
            <local:NaloziMedjuskladisnica/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NaloziZaduzenjeProdavniceViewModel}">
            <local:ZaduzenjeProdavnice/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CentralniMagacinViewModel}">
            <local:CentralniMagacin/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PovratMaterijalaViewModel}">
            <local:PovratMaterijala/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:IzlazMaterijalaViewModel}">
            <local:IzlazMaterijala/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MedjuskladisnicaViewModel}">
            <local:Medjuskladisnica/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:UlazMaterijalaViewModel}">
            <local:UlazMaterijala/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:KomitentiListaViewModel}">
            <local:KomitentiLista/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MatListaViewModel}">
            <local:MatLista/>
        </DataTemplate>


        <DataTemplate DataType="{x:Type vm:InvListaViewModel}">
            <local:InvLista/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SifarnikMaterijalSkladisteKontoViewModel}">
            <local:SifarnikMaterijalSkladisteKonto/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SifarnikMaterijalaViewModel}">
            <local:SifarnikMaterijala/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SifarnikMaterijalaFormViewModel}">
            <local:SifarnikMaterijalaForm/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SifarnikKontaViewModel}">
            <local:SifarnikKonta/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RekapitulacijaTroskovaViewModel}">
            <local:RekapitulacijaTroskova/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RekapitulacijaZalihaViewModel}">
            <local:RekapitulacijaZaliha/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DnevnikViewModel}">
            <local:Dnevnik/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AnalitickaKarticaViewModel}">
            <local:AnalitickaKartica/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PregledUlazaPoKontimaiKalkulacijamaViewModel}">
            <local:PregledUlazaPoKontimaiKalkulacijama/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PregledUlazaZaJednuKalkulacijuViewModel}">
            <local:PregledUlazaZaJednuKalkulaciju/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PregledUlazaZaSveKalkulacijeViewModel}">
            <local:PregledUlazaZaSveKalkulacije/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PregledIzlazaZaSveKalkulacijeViewModel}">
            <local:PregledIzlazaZaSveKalkulacije/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PregledTroskovaPoKontimaINalozimaZaSvaSkladistaViewModel}">
            <local:PregledTroskovaPoKontimaINalozimaZaSvaSkladista/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PregledTroskovaPoKontimaIRadnimNalozimaViewModel}">
            <local:PregledTroskovaPoKontimaIRadnimNalozima/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PregledTroskovaPoKontimaViewModel}">
            <local:PregledTroskovaPoKontima/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StanjeZalihaZaSvaSkladistaViewModel}">
            <local:StanjeZalihaZaSvaSkladista/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StanjeZalihaZaSkladisteViewModel}">
            <local:StanjeZalihaZaSkladiste/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StanjeZalihaZaMaterijalUSkladistuViewModel}">
            <local:StanjeZalihaZaMaterijalUSkladistu/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MedjuskladisniceZaSkladisteViewModel}">
            <local:MedjuskladisniceZaSkladiste/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MedjuskladisniceSveViewModel}">
            <local:MedjuskladisniceSve/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MedjuskladisniceJednaViewModel}">
            <local:MedjuskladisniceJedna/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PregledIzlazaZaJednuKalkulacijuViewModel}">
            <local:PregledIzlazaZaJednuKalkulaciju/>
        </DataTemplate>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#EEF5FF"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#F2F6FC"/>
        <SolidColorBrush x:Key="PressedBrush" Color="#E5EEFB"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#E4E7EC"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#B42318"/>

        <Style x:Key="SidebarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarSubButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="20,1,8,1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>


        <Style x:Key="ExpanderHeaderToggleStyle"
               TargetType="{x:Type ToggleButton}">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">

                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">

                            <Grid Height="44">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    Margin="13,0,4,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"/>

                                <TextBlock x:Name="CollapsedArrow"
                                           Grid.Column="1"
                                           Text="›"
                                           FontFamily="Segoe UI"
                                           FontSize="22"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Visible"/>

                                <TextBlock x:Name="ExpandedArrow"
                                           Grid.Column="1"
                                           Text="⌄"
                                           FontFamily="Segoe UI"
                                           FontSize="18"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="{StaticResource HoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="#FAFBFD"/>

                                <Setter TargetName="CollapsedArrow"
                                        Property="Visibility"
                                        Value="Collapsed"/>

                                <Setter TargetName="ExpandedArrow"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.50"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarExpanderStyle"
               TargetType="{x:Type Expander}">

            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">

                        <StackPanel>

                            <ToggleButton
                                Style="{StaticResource ExpanderHeaderToggleStyle}"
                                Content="{TemplateBinding Header}"
                                IsChecked="{Binding IsExpanded,
                                            RelativeSource={RelativeSource TemplatedParent},
                                            Mode=TwoWay}"/>

                            <ContentPresenter
                                x:Name="ExpandSite"
                                Content="{TemplateBinding Content}"
                                Visibility="Collapsed"/>

                        </StackPanel>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubExpanderHeaderToggleStyle"
               TargetType="{x:Type ToggleButton}"
               BasedOn="{StaticResource ExpanderHeaderToggleStyle}">

            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondaryBrush}"/>

        </Style>

        <Style x:Key="SidebarSubExpanderStyle"
               TargetType="{x:Type Expander}">

            <Setter Property="Margin" Value="14,2,6,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">

                        <StackPanel>

                            <ToggleButton
                                Style="{StaticResource SubExpanderHeaderToggleStyle}"
                                Content="{TemplateBinding Header}"
                                IsChecked="{Binding IsExpanded,
                                            RelativeSource={RelativeSource TemplatedParent},
                                            Mode=TwoWay}"/>

                            <ContentPresenter
                                x:Name="ExpandSite"
                                Content="{TemplateBinding Content}"
                                Visibility="Collapsed"/>

                        </StackPanel>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="20,18,20,14"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="MATERIJALNO"
                                   FontFamily="Segoe UI"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Materijalno knjigovodstvo"
                                   Margin="0,3,0,0"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1"
                              Margin="4,8,4,4"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="glavniStackPanel">

                        <!-- ŠIFARNICI -->
                        <Expander Style="{StaticResource SidebarExpanderStyle}" IsExpanded="True">
                            <Expander.Header>
                                <TextBlock Text="ŠIFARNICI" FontSize="13" FontWeight="SemiBold"/>
                            </Expander.Header>
                            <StackPanel Margin="0,0,0,6">
                                <Button x:Name="skladista" Style="{StaticResource SidebarButtonStyle}" Content="Šifarnik skladišta" Command="{Binding SifarnikSkladistaCommand}"/>
                                <Button x:Name="materijala" Style="{StaticResource SidebarButtonStyle}" Content="Šifarnik materijala" Command="{Binding SifarnikMaterijalaCommand}"/>
                                <Button x:Name="konta" Style="{StaticResource SidebarButtonStyle}" Content="Šifarnik konta" Command="{Binding SifarnikKontaCommand}"/>
                                <Button x:Name="materijalSkladisteKonta" Style="{StaticResource SidebarButtonStyle}" Content="Šifarnik materijal-skladište-konta" Command="{Binding SifarnikMaterijalSkladisteKontoCommand}"/>
                            </StackPanel>
                        </Expander>

                        <!-- PROMET -->
                        <Expander Style="{StaticResource SidebarExpanderStyle}">
                            <Expander.Header>
                                <TextBlock Text="PROMET" FontSize="13" FontWeight="SemiBold"/>
                            </Expander.Header>
                            <StackPanel Margin="0,0,0,6">
                                <Button x:Name="ulazMaterijala" Style="{StaticResource SidebarButtonStyle}" Content="Ulaz materijala" Command="{Binding UlazMaterijalaCommand}"/>
                                <Button x:Name="izlazMaterijala" Style="{StaticResource SidebarButtonStyle}" Content="Izlaz materijala" Command="{Binding IzlazMaterijalaCommand}"/>
                                <Button x:Name="medjuskladisnica" Style="{StaticResource SidebarButtonStyle}" Content="Međuskladišnica" Command="{Binding MedjuskladisnicaCommand}"/>
                                <Button x:Name="povratMaterijala" Style="{StaticResource SidebarButtonStyle}" Content="Povrat materijala" Command="{Binding PovratMaterijalaCommand}"/>
                            </StackPanel>
                        </Expander>

                        <!-- IZVJEŠTAJI -->
                        <Expander Style="{StaticResource SidebarExpanderStyle}">
                            <Expander.Header>
                                <TextBlock Text="IZVJEŠTAJI" FontSize="13" FontWeight="SemiBold"/>
                            </Expander.Header>
                            <StackPanel Margin="0,0,0,6">
                                <Button x:Name="dnevnik" Style="{StaticResource SidebarButtonStyle}" Content="Dnevnik" Command="{Binding DnevnikCommand}"/>
                                <Button x:Name="analitickakartica" Style="{StaticResource SidebarButtonStyle}" Content="Analitička kartica" Command="{Binding AnalitickaKarticaCommand}"/>

                                <Expander Style="{StaticResource SidebarSubExpanderStyle}">
                                    <Expander.Header>
                                        <TextBlock Text="Pregled izlaza" FontWeight="SemiBold"/>
                                    </Expander.Header>
                                    <StackPanel>
                                        <Button x:Name="zaSveKalkulacijePregledIzlaza" Style="{StaticResource SidebarSubButtonStyle}" Content="Za sve kalkulacije" Command="{Binding ZaSveKalkulacijePregledIzlazaCommand}"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource SidebarSubExpanderStyle}">
                                    <Expander.Header>
                                        <TextBlock Text="Međuskladišnice" FontWeight="SemiBold"/>
                                    </Expander.Header>
                                    <StackPanel>
                                        <Button x:Name="jedna" Style="{StaticResource SidebarSubButtonStyle}" Content="Jedna" Command="{Binding MedjuskladisniceJednaCommand}"/>
                                        <Button x:Name="sve" Style="{StaticResource SidebarSubButtonStyle}" Content="Sve" Command="{Binding MedjuskladisniceSveCommand}"/>
                                        <Button x:Name="zaSkladisteMedjuskladisnice" Style="{StaticResource SidebarSubButtonStyle}" Content="Za skladište" Command="{Binding ZaSkladisteMedjuskladisniceCommand}"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource SidebarSubExpanderStyle}">
                                    <Expander.Header>
                                        <TextBlock Text="Stanje zaliha" FontWeight="SemiBold"/>
                                    </Expander.Header>
                                    <StackPanel>
                                        <Button x:Name="zaMaterijalUSkladistu" Style="{StaticResource SidebarSubButtonStyle}" Content="Za materijal u skladištu" Command="{Binding ZaMaterijalUSkladistuCommand}"/>
                                        <Button x:Name="zaSkladisteStanjeZaliha" Style="{StaticResource SidebarSubButtonStyle}" Content="Za skladište" Command="{Binding ZaSkladisteStanjeZalihaCommand}"/>
                                        <Button x:Name="zaSvaSkladista" Style="{StaticResource SidebarSubButtonStyle}" Content="Za sva skladišta" Command="{Binding ZaSvaSkladistaCommand}"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource SidebarSubExpanderStyle}">
                                    <Expander.Header>
                                        <TextBlock Text="Pregled troškova" FontWeight="SemiBold"/>
                                    </Expander.Header>
                                    <StackPanel>
                                        <Button x:Name="poKontima" Style="{StaticResource SidebarSubButtonStyle}" Content="Po kontima" Command="{Binding PoKontimaCommand}"/>
                                        <Button x:Name="poKontimaINalozimaZaSvaSkladista" Style="{StaticResource SidebarSubButtonStyle}" Content="Po kontima i nalozima za sva skladišta" Command="{Binding PoKontimaINalozimaZaSvaSkladistaCommand}"/>
                                    </StackPanel>
                                </Expander>

                                <Button x:Name="rekapitulacijaZaliha" Style="{StaticResource SidebarButtonStyle}" Content="Rekapitulacija zaliha" Command="{Binding RekapitulacijaZalihaCommand}"/>
                            </StackPanel>
                        </Expander>

                        <!-- NALOZI ZA FINANSIJE -->
                        <Expander Style="{StaticResource SidebarExpanderStyle}">
                            <Expander.Header>
                                <TextBlock Text="NALOZI ZA FINANSIJE" FontSize="13" FontWeight="SemiBold"/>
                            </Expander.Header>
                            <StackPanel Margin="0,0,0,6">
                                <Button x:Name="ulazUCentralniMagazin" Style="{StaticResource SidebarButtonStyle}" Content="Ulaz u centralni magazin" Command="{Binding CentralniMagacinCommand}"/>
                                <Button x:Name="zaduzenjeProdavnice" Style="{StaticResource SidebarButtonStyle}" Content="Zaduženje prodavnice" Command="{Binding ZaduzenjeProdavniceCommand}"/>
                                <Button x:Name="medjuskladisnica2" Style="{StaticResource SidebarButtonStyle}" Content="Međuskladišnica" Command="{Binding NaloziMedjuskladisnicaCommand}"/>
                                <Button x:Name="povratUSkladiste" Style="{StaticResource SidebarButtonStyle}" Content="Povrat u skladište" Command="{Binding PovratUSkladisteCommand}"/>
                                <Button x:Name="printanjeNaloga" Style="{StaticResource SidebarButtonStyle}" Content="Printanje naloga" Command="{Binding NaloziZaFinansijePrintanjeNalogaCommand}"/>
                            </StackPanel>
                        </Expander>

                        <!-- INVENTURA -->
                        <Expander Style="{StaticResource SidebarExpanderStyle}">
                            <Expander.Header>
                                <TextBlock Text="INVENTURA" FontSize="13" FontWeight="SemiBold"/>
                            </Expander.Header>
                            <StackPanel Margin="0,0,0,6">
                                <Button x:Name="stampanjeInventurnihListica" Style="{StaticResource SidebarButtonStyle}" Content="Štampanje inventurnih listica" Command="{Binding StampanjeInventurnihListicaCommand}"/>
                                <Button x:Name="unosInventurnogStanja" Style="{StaticResource SidebarButtonStyle}" Content="Unos inventurnog stanja" Command="{Binding UnosInventurnogStanjaCommand}"/>
                                <Button x:Name="stampanjeInventurnihZaliha" Style="{StaticResource SidebarButtonStyle}" Content="Štampanje inventurnih zaliha" Command="{Binding StampanjeInventurnihZalihaCommand}"/>
                            </StackPanel>
                        </Expander>

                        <!-- POČETNO STANJE -->
                        <Expander Style="{StaticResource SidebarExpanderStyle}">
                            <Expander.Header>
                                <TextBlock Text="POČETNO STANJE" FontSize="13" FontWeight="SemiBold"/>
                            </Expander.Header>
                            <StackPanel Margin="0,0,0,6">
                                <Button x:Name="pocetnoStanjePrviPut" Style="{StaticResource SidebarButtonStyle}" Content="Početno stanje prvi put" Command="{Binding PocetnoStanjePrviPutCommand}"/>
                                <Button x:Name="postavkaNovogPocetnogStanja" Style="{StaticResource SidebarButtonStyle}" Content="Postavka novog početnog stanja" Command="{Binding PostavkaNovogPocetnogStanjaCommand}"/>
                            </StackPanel>
                        </Expander>

                        <!-- ARHIVA -->
                        <Button x:Name="arhivaBtn"
                                Style="{StaticResource SidebarButtonStyle}"
                                Height="44"
                                Margin="8,10,8,6"
                                Command="{Binding ArhivaCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Ikone/document.png"
                                       Width="18"
                                       Height="18"
                                       Margin="0,0,10,0"
                                       Stretch="Uniform"/>
                                <TextBlock Text="Arhiva"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>


                <Border Grid.Row="2"
                        Margin="16,8,16,16"
                        Padding="0,12,0,0"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Image Source="/Ikone/Lutrija_logo.png"
                               Height="48"
                               HorizontalAlignment="Left"
                               Stretch="Uniform"/>
                        <TextBlock Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   FontFamily="Segoe UI"
                                   FontSize="10.5"
                                   Foreground="{StaticResource WarningBrush}">
                            <Run Text="INTERNO" FontWeight="Bold"/>
                            <LineBreak/>
                            <Run Text="UPOZORENJE: SVI DOKUMENTI I PODACI MOGU SE KORISTITI SAMO ZA INTERNU UPOTREBU!"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Margin="16"
                Background="{StaticResource ContentBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="1"
                CornerRadius="10"
                SnapsToDevicePixels="True">
            <ContentControl x:Name="odabraniContent"
                            Content="{Binding OdabraniVM}"/>
        </Border>
    </Grid>
</UserControl>