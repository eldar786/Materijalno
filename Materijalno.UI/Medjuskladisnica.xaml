<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:vm="clr-namespace:Materijalno.ViewModel;assembly=Materijalno.ViewModel" xmlns:local="clr-namespace:Materijalno.UI" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" x:Class="Materijalno.UI.Medjuskladisnica" mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1900">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Materijalno.UI;component/Themes/FinanceTheme.xaml"/></ResourceDictionary.MergedDictionaries><DataTemplate DataType="{x:Type vm:MedjuskladisnicaViewModel}">
      <local:Medjuskladisnica/>
    </DataTemplate>
    <Style TargetType="{x:Type DatePicker}" BasedOn="{StaticResource FinanceDatePicker}">
      <Setter Property="Language" Value="de-DE"/>
    </Style>
  </ResourceDictionary></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#F1F5F7">
    <Border Background="White" BorderBrush="#D7E1E7" BorderThickness="1" CornerRadius="10" Margin="20" Padding="20"><StackPanel Margin="0">
      <TextBlock Text="MEĐUSKLADIŠNICA" FontSize="22" Margin="0,0,0,16" FontWeight="SemiBold" Foreground="#203447"/>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Skladište izlaza</Label>
          <TextBox Text="{Binding SourceWarehouse, UpdateSourceTrigger=PropertyChanged}" Name="OpBroj" KeyDown="TextBox_KeyDown" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="LostFocus">
                <i:InvokeCommandAction Command="{Binding OsvjeziCommand}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </TextBox>
          <TextBox KeyDown="TextBox_KeyDown" IsEnabled="False" Text="{Binding SourceWarehouseName, Mode=OneWay}" IsReadOnly="True" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="320"/>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Skladište ulaza</Label>
          <TextBox KeyDown="TextBox_KeyDown" Text="{Binding DestinationWarehouse, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="LostFocus">
                <i:InvokeCommandAction Command="{Binding OsvjeziCommand}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </TextBox>
          <TextBox IsEnabled="False" Text="{Binding DestinationWarehouseName, Mode=OneWay}" IsReadOnly="True" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="320"/>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Datum međuskl.</Label>
          <DatePicker SelectedDate="{Binding CurrentItemMat.Datun,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="DatePicker_PreviewKeyDown" Loaded="DatePicker_Loaded" FontSize="16" Name="dtpOd" VerticalAlignment="Center" MinHeight="30" Width="170"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Broj međuskl.</Label>
          <TextBox Text="{Binding CurrentItemMat.Brfak}" IsReadOnly="True" KeyDown="TextBox_KeyDown" FontSize="14" IsEnabled="False" VerticalAlignment="Center" MinHeight="30" Width="170"/>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Broj dokumenta</Label>
          <TextBox Text="{Binding CurrentItemMat.Brdok}" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170"/>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Red.br</Label>
          <TextBox Text="{Binding CurrentItemMat.Redbr, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" KeyDown="TextBox_KeyDown" FontSize="14" IsEnabled="False" VerticalAlignment="Center" MinHeight="30" Width="320"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Šifra materijala</Label>
          <TextBox x:Name="txtIdent" Text="{Binding CurrentItemMat.Ident}" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="LostFocus">
                <i:InvokeCommandAction Command="{Binding OsvjeziCommand}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </TextBox>
          <TextBox Text="{Binding CurrentItemTabMaterijala.Nazmat}" IsEnabled="False" IsReadOnly="True" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="320"/>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Jedinica mjere</Label>
          <TextBox KeyDown="TextBox_KeyDown" FontSize="14" IsEnabled="False" Text="KOM" VerticalAlignment="Center" MinHeight="30" Width="170"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Konto</Label>
          <TextBox Text="{Binding CurrentItemTabKonto1.Konto1}" KeyDown="TextBox_KeyDown" IsEnabled="False" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170"/>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Količina</Label>
          <TextBox x:Name="txtKolic" Text="{Binding CurrentItemMat.Kolic,                 StringFormat=N2,                 ConverterCulture='de-DE',                 UpdateSourceTrigger=LostFocus,                 Mode=TwoWay,                 TargetNullValue='0,00'}" KeyDown="KolicTextBox_KeyDown" GotKeyboardFocus="TextBox_GotKeyboardFocus" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170" TextAlignment="Right" Typography.NumeralAlignment="Tabular">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="LostFocus">
                <i:InvokeCommandAction Command="{Binding NabavnaCijenaCommand}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Cijena</Label>
          <TextBox Text="{Binding CurrentItemMat.Nc, StringFormat=N9, TargetNullValue='0,00', ConverterCulture='de-DE', UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" KeyDown="TextBox_KeyDown" IsEnabled="False" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="320" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Vrijednost</Label>
          <TextBox Text="{Binding CurrentItemMat.Vrijed, StringFormat=N2, ConverterCulture='de-DE', TargetNullValue='0,00', UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" KeyDown="TextBox_KeyDown" IsEnabled="False" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="320" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
        </StackPanel>
      </WrapPanel>
      <Border Margin="0,14,0,0" Padding="0,18,0,0" BorderBrush="#E1E9ED" BorderThickness="0,1,0,0"><WrapPanel Margin="0">
        <Button Background="White" x:Name="btnStampa" FontSize="13" Click="stampa_button" Margin="0,0,8,8" MinWidth="86" Padding="8,4" Width="112" Height="38" VerticalAlignment="Top" IsEnabled="{Binding CanPrintTransfer}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="/Ikone/printer.png" Stretch="Uniform" Width="18" Height="18"/>
            <TextBlock Text="Štampa" Margin="6,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <Button.ToolTip>
            <ToolTip Content="Pregled i štampa"/>
          </Button.ToolTip>
        </Button>
        <Button Background="White" x:Name="btnSljedeci" FontSize="13" Command="{Binding NextButtonCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38">
          <Button.ToolTip>
            <ToolTip Content="Sljedeci"/>
          </Button.ToolTip>
          <TextBlock Text="&gt;" FontSize="24"/>
        </Button>
        <Button Background="White" x:Name="btnPrethodni" FontSize="13" Command="{Binding PrethodniButtonCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38">
          <Button.ToolTip>
            <ToolTip Content="Prethodni"/>
          </Button.ToolTip>
          <TextBlock Text="&lt;" FontSize="24"/>
        </Button>
        <Button x:Name="btnPrvi" Content="Prvi" FontSize="13" Command="{Binding PrviButtonCommand}" Visibility="{Binding Path=VidljivoOdabirVrsteIncidenta}" Margin="0,0,8,8" MinWidth="64" Padding="14,8" Height="38"/>
        <Button x:Name="btnZadnji" FontSize="13" Content="Zadnji" Command="{Binding ZadnjiButtonCommand}" Visibility="{Binding Path=VidljivoOdabirVrsteIncidenta}" Margin="0,0,8,8" MinWidth="64" Padding="14,8" Height="38"/>
        <Button x:Name="btnTrazi" Content="Traži" FontSize="13" Command="{Binding TraziSifruMaterijalaCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnNovaMedjuskladisnica" Content="Nova međuskladišnica" FontSize="13" Command="{Binding NovaMedjuskladisnicaCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnSnimi" Content="Snimi" FontSize="13" Command="{Binding SpasiNovuKalkulacijuCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Style="{StaticResource FinancePrimaryButton}" Height="38"/>
        <Button x:Name="btnNovaStavka" Content="Nova stavka" FontSize="13" Command="{Binding NovaStavkaButtonCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnSlijedecaStavka" Content="Slij. stavka" FontSize="13" Command="{Binding SlijStavkaButtonCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnBrisanje" Content="Brisanje" FontSize="13" Command="{Binding BrisanjeCommand}" Visibility="{Binding Path=VidljivoOdabirVrsteIncidenta}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Style="{StaticResource FinanceDangerButton}" Height="38"/>
        <Button x:Name="btnOdustani" Content="Odustani" FontSize="13" Command="{Binding OdustaniCommand}" Visibility="{Binding Path=VidljivoOdabirVrsteIncidenta}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnIzlaz" Content="Izlaz" FontSize="13" Command="{Binding IzlazCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
      </WrapPanel>
    </Border></StackPanel>
  </Border></ScrollViewer>
</UserControl>