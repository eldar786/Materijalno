<UserControl x:Class="Materijalno.UI.MedjuskladisniceZaSkladiste"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:vm="clr-namespace:Materijalno.ViewModel;assembly=Materijalno.ViewModel"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Materijalno.UI" xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="1900">
    <UserControl.Resources>

        <DataTemplate DataType="{x:Type vm:MedjuskladisniceZaSkladisteViewModel}">
            <local:MedjuskladisniceZaSkladiste/>
        </DataTemplate>


        <!-- COLORS -->
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E40AF"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085"/>

        <SolidColorBrush x:Key="BorderBrushLight" Color="#D8E0EA"/>
        <SolidColorBrush x:Key="ReadOnlyBackgroundBrush" Color="#F8FAFC"/>


        <!-- LABEL -->
        <Style x:Key="FormLabelStyle"
           TargetType="TextBlock">

            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment"
                Value="Center"/>

        </Style>


        <!-- TEXTBOX -->
        <Style x:Key="FormTextBoxStyle"
           TargetType="TextBox">

            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>

            <Setter Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="Background"
                Value="White"/>

            <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrushLight}"/>

            <Setter Property="BorderThickness"
                Value="1"/>

            <Setter Property="Padding"
                Value="10,4"/>

            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                Value="Left"/>

            <Setter Property="VerticalAlignment"
                Value="Center"/>


            <Style.Triggers>

                <Trigger Property="IsKeyboardFocused"
                     Value="True">

                    <Setter Property="BorderBrush"
                        Value="{StaticResource PrimaryBrush}"/>

                    <Setter Property="BorderThickness"
                        Value="2"/>

                </Trigger>


                <Trigger Property="IsReadOnly"
                     Value="True">

                    <Setter Property="Background"
                        Value="{StaticResource ReadOnlyBackgroundBrush}"/>

                    <Setter Property="Foreground"
                        Value="{StaticResource TextSecondaryBrush}"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- DATE PICKER -->
        <Style x:Key="FormDatePickerStyle"
           TargetType="DatePicker">

            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>

            <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrushLight}"/>

            <Setter Property="BorderThickness"
                Value="1"/>

            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

        </Style>


        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButtonStyle"
           TargetType="Button">

            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Background"
                Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                        x:Name="PrimaryBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter
                                TargetName="PrimaryBorder"
                                Property="Background"
                                Value="{StaticResource PrimaryHoverBrush}"/>

                            </Trigger>


                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter
                                TargetName="PrimaryBorder"
                                Property="Background"
                                Value="{StaticResource PrimaryPressedBrush}"/>

                            </Trigger>


                            <Trigger Property="IsEnabled"
                                 Value="False">

                                <Setter
                                Property="Opacity"
                                Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>


    <Grid Background="{StaticResource PageBackgroundBrush}">

        <Grid.RowDefinitions>

            <!-- HEADER -->
            <RowDefinition Height="Auto"/>

            <!-- FORM -->
            <RowDefinition Height="Auto"/>

            <!-- EMPTY SPACE -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- HEADER -->
        <StackPanel
        Grid.Row="0"
        Margin="24,18,24,18"
        HorizontalAlignment="Left">

            <TextBlock
            Text="PREGLED SVIH MEĐUSKLADIŠNICA ZA SKLADIŠTE"
            FontFamily="Segoe UI"
            FontSize="22"
            FontWeight="SemiBold"
            Foreground="{StaticResource TextPrimaryBrush}"/>

            <TextBlock
            Text="Odaberite skladište i period za štampanje pregleda međuskladišnica"
            Margin="0,4,0,0"
            FontFamily="Segoe UI"
            FontSize="12.5"
            Foreground="{StaticResource TextSecondaryBrush}"/>

        </StackPanel>


        <!-- MAIN FORM CARD -->
        <Border
        Grid.Row="1"
        Width="650"
        HorizontalAlignment="Center"
        Padding="24"
        Background="{StaticResource CardBackgroundBrush}"
        BorderBrush="{StaticResource BorderBrushLight}"
        BorderThickness="1"
        CornerRadius="12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="62"/>
                </Grid.RowDefinitions>


                <Grid.ColumnDefinitions>

                    <!-- LABEL -->
                    <ColumnDefinition Width="130"/>

                    <!-- CODE / DATE -->
                    <ColumnDefinition Width="150"/>

                    <!-- GAP -->
                    <ColumnDefinition Width="16"/>

                    <!-- DESCRIPTION / DATE -->
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- SKLADIŠTE -->
                <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="Skladište"
                Style="{StaticResource FormLabelStyle}"/>


                <TextBox
                Grid.Row="0"
                Grid.Column="1"
                Text="{Binding CurrentItemMat.Kljnaz}"
                KeyDown="TextBox_KeyDown"
                Name="OpBroj"
                FontWeight="Bold"
                Style="{StaticResource FormTextBoxStyle}">

                    <i:Interaction.Triggers>

                        <i:EventTrigger EventName="LostFocus">

                            <i:InvokeCommandAction
                            Command="{Binding OsvjeziCommand}" />

                        </i:EventTrigger>

                    </i:Interaction.Triggers>

                </TextBox>


                <TextBox
    Grid.Row="0"
    Grid.Column="3"
    KeyDown="TextBox_KeyDown"
    Text="{Binding CurrentItemTabSkladista.NazivOrg, UpdateSourceTrigger=PropertyChanged}"
    IsReadOnly="True"
    Style="{StaticResource FormTextBoxStyle}"/>


                <!-- PERIOD -->
                <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Text="Period"
                Style="{StaticResource FormLabelStyle}"
                VerticalAlignment="Center"/>


                <!-- OD DATUMA -->
                <StackPanel
                Grid.Row="2"
                Grid.Column="1">

                    <TextBlock
                    Text="Od datuma"
                    FontFamily="Segoe UI"
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Margin="0,0,0,5"/>

                    <DatePicker
                    SelectedDate="{Binding CurrentItemMat.Datun}"
                    KeyDown="TextBox_KeyDown"
                    SelectedDateChanged="datOd_SelectedDateChanged"
                    Name="dtpOd"
                    Style="{StaticResource FormDatePickerStyle}"/>

                </StackPanel>


                <!-- DO DATUMA -->
                <StackPanel
                Grid.Row="2"
                Grid.Column="3"
                HorizontalAlignment="Left">

                    <TextBlock
                    Text="Do datuma"
                    FontFamily="Segoe UI"
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Margin="0,0,0,5"/>

                    <StackPanel Orientation="Horizontal">

                        <DatePicker
                        SelectedDate="{Binding CurrentItemMat.Datnar, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="TextBox_KeyDown"
                        SelectedDateChanged="datDo_SelectedDateChanged"
                        Name="dtpDo"
                        Width="150"
                        Style="{StaticResource FormDatePickerStyle}"/>


                        <Button
                        x:Name="btnStampa"
                        Content="Štampa"
                        Click="stampa_button"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="16,0,0,0"
                        VerticalAlignment="Bottom">

                            <Button.ToolTip>
                                <ToolTip Content="Print"/>
                            </Button.ToolTip>

                        </Button>

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>