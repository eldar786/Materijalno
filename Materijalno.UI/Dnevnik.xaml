<UserControl x:Class="Materijalno.UI.Dnevnik"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Materijalno.ViewModel;assembly=Materijalno.ViewModel"
             xmlns:local="clr-namespace:Materijalno.UI" xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="1900">

    <UserControl.Resources>

        <DataTemplate DataType="{x:Type vm:DnevnikViewModel}">
            <local:Dnevnik/>
        </DataTemplate>


        <!-- ====================================================== -->
        <!-- COLORS                                                 -->
        <!-- ====================================================== -->

        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E40AF"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085"/>

        <SolidColorBrush x:Key="BorderBrushLight" Color="#D8E0EA"/>
        <SolidColorBrush x:Key="ReadOnlyBackgroundBrush" Color="#F8FAFC"/>


        <!-- ====================================================== -->
        <!-- LABEL                                                  -->
        <!-- ====================================================== -->

        <Style x:Key="FormLabelStyle"
           TargetType="TextBlock">

            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="VerticalAlignment"
                Value="Center"/>

        </Style>


        <!-- ====================================================== -->
        <!-- NORMAL TEXTBOX                                         -->
        <!-- IMPORTANT: NO CUSTOM CONTROL TEMPLATE                  -->
        <!-- ====================================================== -->

        <Style x:Key="FormTextBoxStyle"
           TargetType="TextBox">

            <Setter Property="Height" Value="40"/>

            <Setter Property="FontFamily"
                Value="Segoe UI"/>

            <Setter Property="FontSize"
                Value="15"/>

            <Setter Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="Background"
                Value="White"/>

            <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrushLight}"/>

            <Setter Property="BorderThickness"
                Value="1"/>

            <Setter Property="Padding"
                Value="10,4"/>

            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                Value="Left"/>

            <Setter Property="VerticalAlignment"
                Value="Center"/>


            <Style.Triggers>

                <!-- FOCUSED -->
                <Trigger Property="IsKeyboardFocused"
                     Value="True">

                    <Setter Property="BorderBrush"
                        Value="{StaticResource PrimaryBrush}"/>

                    <Setter Property="BorderThickness"
                        Value="2"/>

                </Trigger>


                <!-- READ ONLY -->
                <Trigger Property="IsReadOnly"
                     Value="True">

                    <Setter Property="Background"
                        Value="{StaticResource ReadOnlyBackgroundBrush}"/>

                    <Setter Property="Foreground"
                        Value="{StaticResource TextSecondaryBrush}"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ====================================================== -->
        <!-- DATE PICKER                                            -->
        <!-- ====================================================== -->

        <Style x:Key="FormDatePickerStyle"
           TargetType="DatePicker">

            <Setter Property="Height"
                Value="40"/>

            <Setter Property="FontFamily"
                Value="Segoe UI"/>

            <Setter Property="FontSize"
                Value="15"/>

            <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrushLight}"/>

            <Setter Property="BorderThickness"
                Value="1"/>

            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

        </Style>


        <!-- ====================================================== -->
        <!-- PRIMARY BUTTON                                         -->
        <!-- ====================================================== -->

        <Style x:Key="PrimaryButtonStyle"
           TargetType="Button">

            <Setter Property="Width"
                Value="130"/>

            <Setter Property="Height"
                Value="44"/>

            <Setter Property="FontFamily"
                Value="Segoe UI"/>

            <Setter Property="FontSize"
                Value="14"/>

            <Setter Property="FontWeight"
                Value="SemiBold"/>

            <Setter Property="Foreground"
                Value="White"/>

            <Setter Property="Background"
                Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="BorderThickness"
                Value="0"/>

            <Setter Property="Cursor"
                Value="Hand"/>


            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                        x:Name="PrimaryBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter
                                TargetName="PrimaryBorder"
                                Property="Background"
                                Value="{StaticResource PrimaryHoverBrush}"/>

                            </Trigger>


                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter
                                TargetName="PrimaryBorder"
                                Property="Background"
                                Value="{StaticResource PrimaryPressedBrush}"/>

                            </Trigger>


                            <Trigger Property="IsEnabled"
                                 Value="False">

                                <Setter
                                Property="Opacity"
                                Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ====================================================== -->
        <!-- SECONDARY BUTTON                                       -->
        <!-- ====================================================== -->

        <Style x:Key="SecondaryButtonStyle"
           TargetType="Button">

            <Setter Property="Width"
                Value="130"/>

            <Setter Property="Height"
                Value="44"/>

            <Setter Property="FontFamily"
                Value="Segoe UI"/>

            <Setter Property="FontSize"
                Value="14"/>

            <Setter Property="FontWeight"
                Value="SemiBold"/>

            <Setter Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="Background"
                Value="White"/>

            <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrushLight}"/>

            <Setter Property="BorderThickness"
                Value="1"/>

            <Setter Property="Cursor"
                Value="Hand"/>


            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                        x:Name="SecondaryBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter
                                TargetName="SecondaryBorder"
                                Property="Background"
                                Value="#F3F6FA"/>

                                <Setter
                                TargetName="SecondaryBorder"
                                Property="BorderBrush"
                                Value="#98A2B3"/>

                            </Trigger>


                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter
                                TargetName="SecondaryBorder"
                                Property="Background"
                                Value="#E8EEF5"/>

                            </Trigger>


                            <Trigger Property="IsEnabled"
                                 Value="False">

                                <Setter
                                Property="Opacity"
                                Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>



    <!-- ========================================================== -->
    <!-- PAGE                                                       -->
    <!-- ========================================================== -->

    <Grid Background="{StaticResource PageBackgroundBrush}">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ====================================================== -->
        <!-- HEADER                                                 -->
        <!-- KEEP TOP LEFT                                          -->
        <!-- ====================================================== -->

        <StackPanel
        Grid.Row="0"
        Margin="24,18,24,18"
        HorizontalAlignment="Left">

            <TextBlock
            Text="DNEVNIK"
            FontFamily="Segoe UI"
            FontSize="22"
            FontWeight="SemiBold"
            Foreground="{StaticResource TextPrimaryBrush}"/>


            <TextBlock
            Text="Odaberite skladište, materijal i period za prikaz dnevnika"
            Margin="0,4,0,0"
            FontFamily="Segoe UI"
            FontSize="12.5"
            Foreground="{StaticResource TextSecondaryBrush}"/>

        </StackPanel>


        <!-- ====================================================== -->
        <!-- CENTER AREA                                            -->
        <!-- ====================================================== -->

        <Grid
        Grid.Row="1"
        HorizontalAlignment="Center">


            <!-- ================================================== -->
            <!-- FILTER CARD                                        -->
            <!-- ================================================== -->

            <Border
            Width="650"
            HorizontalAlignment="Center"
            Padding="24"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrushLight}"
            BorderThickness="1"
            CornerRadius="12">


                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="40"/>

                        <RowDefinition Height="22"/>

                        <RowDefinition Height="40"/>

                        <RowDefinition Height="22"/>

                        <RowDefinition Height="62"/>

                    </Grid.RowDefinitions>


                    <Grid.ColumnDefinitions>

                        <!-- LABEL -->
                        <ColumnDefinition Width="130"/>

                        <!-- CODE -->
                        <ColumnDefinition Width="150"/>

                        <!-- SPACING -->
                        <ColumnDefinition Width="16"/>

                        <!-- DESCRIPTION -->
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ================================================== -->
                    <!-- SKLADISTE                                         -->
                    <!-- ================================================== -->

                    <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Skladište"
                    Style="{StaticResource FormLabelStyle}"/>


                    <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Name="OpBroj"
                    Text="{Binding CurrentItemMat.Kljnaz}"
                    KeyDown="TextBox_KeyDown"
                    FontWeight="SemiBold"
                    Style="{StaticResource FormTextBoxStyle}">

                        <i:Interaction.Triggers>

                            <i:EventTrigger EventName="LostFocus">

                                <i:InvokeCommandAction
                                Command="{Binding OsvjeziCommand}" />

                            </i:EventTrigger>

                        </i:Interaction.Triggers>

                    </TextBox>


                    <TextBox
                    Grid.Row="0"
                    Grid.Column="3"
                    Text="{Binding CurrentItemTabSkladista.NazivOrg,
                                   UpdateSourceTrigger=PropertyChanged}"
                    IsReadOnly="True"
                    KeyDown="TextBox_KeyDown"
                    Style="{StaticResource FormTextBoxStyle}"/>


                    <!-- ================================================== -->
                    <!-- SIFRA MATERIJALA                                  -->
                    <!-- ================================================== -->

                    <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="Šifra materijala"
                    Style="{StaticResource FormLabelStyle}"/>


                    <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{Binding CurrentItemMat.Ident}"
                    KeyDown="TextBox_KeyDown"
                    Style="{StaticResource FormTextBoxStyle}">

                        <i:Interaction.Triggers>

                            <i:EventTrigger EventName="LostFocus">

                                <i:InvokeCommandAction
                                Command="{Binding OsvjeziCommand}" />

                            </i:EventTrigger>

                        </i:Interaction.Triggers>

                    </TextBox>


                    <TextBox
                    Grid.Row="2"
                    Grid.Column="3"
                    Text="{Binding CurrentItemTabMaterijala.Nazmat}"
                    IsReadOnly="True"
                    KeyDown="TextBox_KeyDown"
                    Style="{StaticResource FormTextBoxStyle}"/>


                    <!-- ================================================== -->
                    <!-- PERIOD                                            -->
                    <!-- ================================================== -->

                    <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Text="Period"
                    Style="{StaticResource FormLabelStyle}"
                    VerticalAlignment="Center"/>


                    <!-- OD -->
                    <StackPanel
                    Grid.Row="4"
                    Grid.Column="1">

                        <TextBlock
                        Text="Od"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Margin="0,0,0,5"/>


                        <DatePicker
                        Name="dtpOd"
                        SelectedDate="{Binding CurrentItemMat.Datun}"
                        Style="{StaticResource FormDatePickerStyle}"/>

                    </StackPanel>


                    <!-- DO -->
                    <StackPanel
                    Grid.Row="4"
                    Grid.Column="3"
                    Width="200"
                    HorizontalAlignment="Left">

                        <TextBlock
                        Text="Do"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Margin="0,0,0,5"/>


                        <DatePicker
                        Name="dtpDo"
                        SelectedDate="{Binding CurrentItemMat.Datnar,
                                               UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource FormDatePickerStyle}"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>


        <!-- ====================================================== -->
        <!-- ACTION CARD                                            -->
        <!-- ====================================================== -->

        <Border
        Grid.Row="2"
        Width="650"
        HorizontalAlignment="Center"
        Margin="0,14,0,0"
        Padding="20"
        Background="{StaticResource CardBackgroundBrush}"
        BorderBrush="{StaticResource BorderBrushLight}"
        BorderThickness="1"
        CornerRadius="10">


            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="15"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ACTION TITLE -->
                <StackPanel
                Grid.Row="0"
                HorizontalAlignment="Center">

                    <TextBlock
                    Text="Akcije"
                    FontFamily="Segoe UI"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    HorizontalAlignment="Center"/>


                    <TextBlock
                    Text="Štampanje dnevnika ili izlaz iz pregleda"
                    Margin="0,3,0,0"
                    FontFamily="Segoe UI"
                    FontSize="11.5"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    HorizontalAlignment="Center"/>

                </StackPanel>


                <!-- BUTTONS -->
                <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Center">


                    <!-- STAMPA -->
                    <Button
                    x:Name="btnPrvi"
                    Content="Štampa"
                    Click="stampa_button"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,10,0"/>


                    <!-- IZLAZ -->
                    <Button
                    x:Name="btnTrazi"
                    Content="Izlaz"
                    Command="{Binding ObrisiCommand}"
                    Visibility="{Binding Path=VidljivoOdabirVrsteIncidenta}"
                    Style="{StaticResource SecondaryButtonStyle}"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>