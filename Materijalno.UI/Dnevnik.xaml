<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:vm="clr-namespace:Materijalno.ViewModel;assembly=Materijalno.ViewModel" xmlns:local="clr-namespace:Materijalno.UI" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" x:Class="Materijalno.UI.Dnevnik" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="1900">

    <UserControl.Resources>

        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Materijalno.UI;component/Themes/FinanceTheme.xaml"/></ResourceDictionary.MergedDictionaries><DataTemplate DataType="{x:Type vm:DnevnikViewModel}">
            <local:Dnevnik/>
        </DataTemplate>


        <!-- ====================================================== -->
        <!-- COLORS                                                 -->
        <!-- ====================================================== -->

        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F1F5F7"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#087F82"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#06686C"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#07575C"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#203447"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#596D7E"/>

        <SolidColorBrush x:Key="BorderBrushLight" Color="#CDD8E0"/>
        <SolidColorBrush x:Key="ReadOnlyBackgroundBrush" Color="#F8FAFC"/>


        <!-- ====================================================== -->
        <!-- LABEL                                                  -->
        <!-- ====================================================== -->

        <Style x:Key="FormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FinanceLabel}">

            </Style>


        <!-- ====================================================== -->
        <!-- NORMAL TEXTBOX                                         -->
        <!-- IMPORTANT: NO CUSTOM CONTROL TEMPLATE                  -->
        <!-- ====================================================== -->

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FinanceTextBox}">

            <Setter Property="Height" Value="40"/>

            </Style>


        <!-- ====================================================== -->
        <!-- DATE PICKER                                            -->
        <!-- ====================================================== -->

        <Style x:Key="FormDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource FinanceDatePicker}">

            <Setter Property="Height" Value="40"/>

            </Style>


        <!-- ====================================================== -->
        <!-- PRIMARY BUTTON                                         -->
        <!-- ====================================================== -->

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FinancePrimaryButton}">

            <Setter Property="Width" Value="130"/>

            <Setter Property="Height" Value="44"/>

            </Style>


        <!-- ====================================================== -->
        <!-- SECONDARY BUTTON                                       -->
        <!-- ====================================================== -->

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FinanceButton}">

            <Setter Property="Width" Value="130"/>

            <Setter Property="Height" Value="44"/>

            </Style>

    </ResourceDictionary></UserControl.Resources>



    <!-- ========================================================== -->
    <!-- PAGE                                                       -->
    <!-- ========================================================== -->

    <Grid Background="{StaticResource PageBackgroundBrush}">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ====================================================== -->
        <!-- HEADER                                                 -->
        <!-- KEEP TOP LEFT                                          -->
        <!-- ====================================================== -->

        <StackPanel Grid.Row="0" Margin="24,18,24,18" HorizontalAlignment="Left">

            <TextBlock Text="DNEVNIK" FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold" Foreground="#203447"/>


            <TextBlock Text="Odaberite skladište, materijal i period za prikaz dnevnika" Margin="0,4,0,0" FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>

        </StackPanel>


        <!-- ====================================================== -->
        <!-- CENTER AREA                                            -->
        <!-- ====================================================== -->

        <Grid Grid.Row="1" HorizontalAlignment="Center">


            <!-- ================================================== -->
            <!-- FILTER CARD                                        -->
            <!-- ================================================== -->

            <Border Width="650" HorizontalAlignment="Center" Padding="24" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="12">


                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="40"/>

                        <RowDefinition Height="22"/>

                        <RowDefinition Height="40"/>

                        <RowDefinition Height="22"/>

                        <RowDefinition Height="62"/>

                    </Grid.RowDefinitions>


                    <Grid.ColumnDefinitions>

                        <!-- LABEL -->
                        <ColumnDefinition Width="130"/>

                        <!-- CODE -->
                        <ColumnDefinition Width="150"/>

                        <!-- SPACING -->
                        <ColumnDefinition Width="16"/>

                        <!-- DESCRIPTION -->
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ================================================== -->
                    <!-- SKLADISTE                                         -->
                    <!-- ================================================== -->

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Skladište" Style="{StaticResource FormLabelStyle}"/>


                    <TextBox Grid.Row="0" Grid.Column="1" Name="OpBroj" Text="{Binding CurrentItemMat.Kljnaz}" KeyDown="TextBox_KeyDown" FontWeight="SemiBold" Style="{StaticResource FormTextBoxStyle}">

                        <i:Interaction.Triggers>

                            <i:EventTrigger EventName="LostFocus">

                                <i:InvokeCommandAction Command="{Binding OsvjeziCommand}"/>

                            </i:EventTrigger>

                        </i:Interaction.Triggers>

                    </TextBox>


                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding CurrentItemTabSkladista.NazivOrg,                                    UpdateSourceTrigger=PropertyChanged}" IsEnabled="False" KeyDown="TextBox_KeyDown" Style="{StaticResource FormTextBoxStyle}"/>


                    <!-- ================================================== -->
                    <!-- SIFRA MATERIJALA                                  -->
                    <!-- ================================================== -->

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Šifra materijala" Style="{StaticResource FormLabelStyle}"/>


                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentItemMat.Ident}" KeyDown="TextBox_KeyDown" Style="{StaticResource FormTextBoxStyle}">

                        <i:Interaction.Triggers>

                            <i:EventTrigger EventName="LostFocus">

                                <i:InvokeCommandAction Command="{Binding OsvjeziCommand}"/>

                            </i:EventTrigger>

                        </i:Interaction.Triggers>

                    </TextBox>


                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding CurrentItemTabMaterijala.Nazmat}" IsEnabled="False" KeyDown="TextBox_KeyDown" Style="{StaticResource FormTextBoxStyle}"/>


                    <!-- ================================================== -->
                    <!-- PERIOD                                            -->
                    <!-- ================================================== -->

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Period" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>


                    <!-- OD -->
                    <StackPanel Grid.Row="4" Grid.Column="1">

                        <TextBlock Text="Od" FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>


                        <DatePicker Name="dtpOd" SelectedDate="{Binding CurrentItemMat.Datun,                            UpdateSourceTrigger=PropertyChanged}" Loaded="DatePicker_Loaded" Style="{StaticResource FormDatePickerStyle}"/>

                    </StackPanel>


                    <!-- DO -->
                    <StackPanel Grid.Row="4" Grid.Column="3" Width="200" HorizontalAlignment="Left">

                        <TextBlock Text="Do" FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>


                        <DatePicker Name="dtpDo" SelectedDate="{Binding CurrentItemMat.Datnar,                            UpdateSourceTrigger=PropertyChanged}" Loaded="DatePicker_Loaded" Style="{StaticResource FormDatePickerStyle}"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>


        <!-- ====================================================== -->
        <!-- ACTION CARD                                            -->
        <!-- ====================================================== -->

        <Border Grid.Row="2" Width="650" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="20" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="10">


            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="15"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ACTION TITLE -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center">

                    <TextBlock Text="Akcije" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>


                    <TextBlock Text="Štampanje dnevnika ili izlaz iz pregleda" Margin="0,3,0,0" FontFamily="Segoe UI" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>

                </StackPanel>


                <!-- BUTTONS -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">


                    <!-- STAMPA -->
                    <Button x:Name="btnPrvi" Content="Štampa" Click="stampa_button" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>


                    <!-- IZLAZ -->
                    <Button x:Name="btnTrazi" Content="Izlaz" Command="{Binding ObrisiCommand}" Visibility="{Binding Path=VidljivoOdabirVrsteIncidenta}" Style="{StaticResource SecondaryButtonStyle}"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>