<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:vm="clr-namespace:Materijalno.ViewModel;assembly=Materijalno.ViewModel" xmlns:local="clr-namespace:Materijalno.UI" x:Class="Materijalno.UI.SifarnikSkladista" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="1900">


    <!-- DataContext je dodat kroz konstruktor, uzima iz SifarnikSkladistaViewModel -->
    <UserControl.Resources>

        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Materijalno.UI;component/Themes/FinanceTheme.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate DataType="{x:Type vm:SifarnikSkladistaViewModel}">
            <local:SifarnikSkladista/>
        </DataTemplate>

        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F1F5F7"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#087F82"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#06686C"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#07575C"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#E7F3F2"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#203447"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#596D7E"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#D7E1E7"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#F7FAFC"/>
        <SolidColorBrush x:Key="DangerLightBrush" Color="#FFF1F1"/>
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#F0B4B4"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>


        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FinanceButton}">

            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            </Style>


        <Style x:Key="DeleteActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FinanceDangerButton}">

            </Style>


        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FinancePrimaryButton}">

            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            </Style>


        <Style x:Key="TableIconButtonStyle" TargetType="Button" BasedOn="{StaticResource FinanceButton}">

            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            </Style>


        <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource FinanceColumnHeader}">

            <Setter Property="Height" Value="42"/>
            </Style>

    </ResourceDictionary></UserControl.Resources>


    <Grid Background="{StaticResource PageBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0" Margin="30,24,30,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="0" VerticalAlignment="Center">

                <TextBlock Text="ŠIFARNIK SKLADIŠTA" FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold" Foreground="#203447"/>

                <TextBlock Text="Pregled i upravljanje skladištima" Margin="0,4,0,0" FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>

            </StackPanel>


            <!-- PRINT -->
            <Button Grid.Column="1" x:Name="btnStampa" Style="{StaticResource ActionButtonStyle}" Click="stampa_button" VerticalAlignment="Center" Content="Štampa" Width="90" Height="38">

                <Button.ToolTip>
                    <ToolTip Content="Print"/>
                </Button.ToolTip>

            </Button>

        </Grid>


        <Border Grid.Row="1" Margin="30,0,30,0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" SnapsToDevicePixels="True">

            <ListView x:Name="GrKomitenti" ItemsSource="{Binding SifarnikSkladistaList}" SelectedItem="{Binding SelectedSifarnikSkladista, Mode=TwoWay}" Background="White" BorderThickness="0" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" AlternationCount="2">


                <!-- ROW STYLE -->
                <ListView.ItemContainerStyle>

                    <Style TargetType="ListViewItem" BasedOn="{StaticResource FinanceListRow}">

                        <Setter Property="Margin" Value="0"/>
                        </Style>

                </ListView.ItemContainerStyle>


                <ListView.View>

                    <GridView>

                        <!-- EDIT BUTTON -->
                        <GridViewColumn Width="60">

                            <GridViewColumn.CellTemplate>
                                <DataTemplate>

                                    <Button Style="{StaticResource TableIconButtonStyle}" Command="{Binding DataContext.IzmjenaSifarnikSkladistaFormCommand,                                                       RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" HorizontalAlignment="Center" Content="Uredi" Width="46" Height="28" MinHeight="28" Padding="3,3" FontSize="11">

                                        <Button.ToolTip>
                                            <ToolTip Content="Uredi"/>
                                        </Button.ToolTip>

                                    </Button>

                                </DataTemplate>
                            </GridViewColumn.CellTemplate>

                        </GridViewColumn>


                        <GridViewColumn Header="Kljnaz" DisplayMemberBinding="{Binding Kljnaz}" Width="150"/>

                        <GridViewColumn Header="Naziv organizacije" DisplayMemberBinding="{Binding NazivOrg}" Width="420"/>

                        <GridViewColumn Header="Opština" DisplayMemberBinding="{Binding Opstina}" Width="210"/>

                        <GridViewColumn Header="Mjesto / adresa" DisplayMemberBinding="{Binding MjestoAdresa}" Width="260"/>

                    </GridView>

                </ListView.View>

            </ListView>

        </Border>


        <Grid Grid.Row="2" Margin="30,14,30,24">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">


                <!-- EDIT SELECTED -->
                <Button x:Name="btnIzmjena" Command="{Binding IzmjenaSifarnikSkladistaFormCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Content="Uredi" Width="90" Height="38">

                    <Button.ToolTip>
                        <ToolTip Content="Uredi"/>
                    </Button.ToolTip>

                </Button>


                <!-- DELETE -->
                <Button x:Name="btnBrisanje" Command="{Binding DeleteSifarnikSkladistaCommand}" Style="{StaticResource DeleteActionButtonStyle}" Margin="0,0,10,0" Content="Obriši" Width="90" Height="38">

                    <Button.ToolTip>
                        <ToolTip Content="Obriši"/>
                    </Button.ToolTip>

                </Button>


                <!-- ADD -->
                <Button x:Name="btnUnos" Command="{Binding OpenSifarnikSkladistaFormCommand,                                       Mode=TwoWay,                                       UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PrimaryActionButtonStyle}" Content="Dodaj" Width="90" Height="38">

                    <Button.ToolTip>
                        <ToolTip Content="Dodaj"/>
                    </Button.ToolTip>

                </Button>


            </StackPanel>

        </Grid>

    </Grid>

</UserControl>