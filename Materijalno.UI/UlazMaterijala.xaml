<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:vm="clr-namespace:Materijalno.ViewModel;assembly=Materijalno.ViewModel" xmlns:local="clr-namespace:Materijalno.UI" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" x:Class="Materijalno.UI.UlazMaterijala" mc:Ignorable="d" d:DesignHeight="1000" d:DesignWidth="1900">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Materijalno.UI;component/Themes/FinanceTheme.xaml"/></ResourceDictionary.MergedDictionaries><DataTemplate DataType="{x:Type vm:UlazMaterijalaViewModel}">
      <local:UlazMaterijala/>
    </DataTemplate>
    <!-- Set the Culture for DatePicker globally -->
    <Style TargetType="{x:Type DatePicker}" BasedOn="{StaticResource FinanceDatePicker}">
      <Setter Property="Language" Value="de-DE"/>
    </Style>
  </ResourceDictionary></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#F1F5F7">
    <Border Background="White" BorderBrush="#D7E1E7" BorderThickness="1" CornerRadius="10" Margin="20" Padding="20"><StackPanel Margin="0">
      <TextBlock Text="ULAZ MATERIJALA" FontSize="22" Margin="0,0,0,16" FontWeight="SemiBold" Foreground="#203447"/>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Skladište</Label>
          <TextBox Text="1000" Name="OpBroj" KeyDown="TextBox_KeyDown" FontWeight="Bold" FontSize="14" IsEnabled="False" VerticalAlignment="Center" MinHeight="30" Width="170"/>
          <TextBox KeyDown="TextBox_KeyDown" Name="tabelaSifarnikSkladista" FontSize="14" Text="LUTRIJA BIH-CENTRALNI MAGACIN INTERNO" IsEnabled="False" VerticalAlignment="Center" MinHeight="30" Width="320">
            <TextBox.InputBindings>
              <MouseBinding Gesture="LeftClick" Command="{Binding UlazMaterijalaSifarnikSkladistaCommand}"/>
            </TextBox.InputBindings>
          </TextBox>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Datum kalkulacije</Label>
          <DatePicker Name="dtpDatun" SelectedDate="{Binding CurrentItemMat.Datun,                            UpdateSourceTrigger=PropertyChanged}" Loaded="DatePicker_Loaded" KeyDown="TextBox_KeyDown" FontSize="16" VerticalAlignment="Center" MinHeight="30" Width="170"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Broj kalkulacije:</Label>
          <TextBox Text="{Binding CurrentItemMat.Brfak}" KeyDown="TextBox_KeyDown" FontSize="14" IsEnabled="False" VerticalAlignment="Center" MinHeight="30" Width="170"/>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Šifra komitenta</Label>
          <TextBox Text="{Binding CurrentItemMat.Analst}" x:Name="txtAnalst" CharacterCasing="Upper" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170">
            <TextBox.InputBindings>
              <MouseBinding Gesture="RightClick" Command="{Binding OtvoriKomitentListuCommand}"/>
            </TextBox.InputBindings>
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="GotFocus">
                <i:InvokeCommandAction Command="{Binding BrojKalkulacijeCommand}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </TextBox>
          <TextBox Text="{Binding CurrentNazivZaSifruKomitenta, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False" KeyDown="TextBox_KeyDown" FontSize="14" Name="SifraKomitenta" VerticalAlignment="Center" MinHeight="30" Width="320">
            <TextBox.InputBindings>
              <MouseBinding Gesture="LeftClick" Command="{Binding OtvoriKomitentListuCommand}"/>
            </TextBox.InputBindings>
          </TextBox>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Broj dokumenta</Label>
          <TextBox Text="{Binding CurrentItemMat.Brdok}" CharacterCasing="Upper" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Datum dokumenta</Label>
          <DatePicker Name="dtpOd1" SelectedDate="{Binding CurrentItemMat.Datnar, UpdateSourceTrigger=PropertyChanged}" Loaded="DatePicker_Loaded" FontSize="16" VerticalAlignment="Center" MinHeight="30" Width="170"/>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Red.br</Label>
          <TextBox Text="{Binding CurrentItemMat.Redbr}" IsEnabled="False" x:Name="txtRedbr" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Šifra materijala</Label>
          <TextBox x:Name="txtIdent" Text="{Binding CurrentItemMat.Ident}" KeyDown="TextBox_KeyDown" FontSize="14" Focusable="True" VerticalAlignment="Center" MinHeight="30" Width="170">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="LostFocus">
                <i:InvokeCommandAction Command="{Binding OsvjeziCommand}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </TextBox>
          <TextBox Text="{Binding CurrentItemTabMaterijala.Nazmat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14" IsEnabled="False" VerticalAlignment="Center" MinHeight="30" Width="320"/>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Količina</Label>
          <TextBox Text="{Binding CurrentItemMat.Kolic, StringFormat=N2, TargetNullValue='0', ConverterCulture='de-DE', UpdateSourceTrigger=PropertyChanged}" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170" TextAlignment="Right" Typography.NumeralAlignment="Tabular">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="LostFocus">
                <i:InvokeCommandAction Command="{Binding NabavnaCijenaCommand}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Fakturna vrijednost</Label>
          <TextBox x:Name="txtFvrijed" Text="{Binding CurrentItemMat.Fvrijed,                         Mode=TwoWay,                         UpdateSourceTrigger=PropertyChanged}" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170" TextAlignment="Right" Typography.NumeralAlignment="Tabular">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="LostFocus">
                <i:InvokeCommandAction Command="{Binding NabavnaCijenaCommand}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </TextBox>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Iznos PDV-a</Label>
          <TextBox Text="{Binding CurrentItemMat.Porppp, TargetNullValue='0,00', StringFormat=N2, ConverterCulture='de-DE', UpdateSourceTrigger=PropertyChanged}" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170" TextAlignment="Right" Typography.NumeralAlignment="Tabular">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="LostFocus">
                <i:InvokeCommandAction Command="{Binding NabavnaCijenaCommand}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Troškovi špeditera</Label>
          <TextBox Text="{Binding CurrentItemMat.Trospe, TargetNullValue='0,00', StringFormat=N2, ConverterCulture='de-DE', UpdateSourceTrigger=PropertyChanged}" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170" TextAlignment="Right" Typography.NumeralAlignment="Tabular">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="LostFocus">
                <i:InvokeCommandAction Command="{Binding NabavnaCijenaCommand}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </TextBox>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Carina</Label>
          <TextBox Text="{Binding CurrentItemMat.Cartro, TargetNullValue='0,00', StringFormat=N2, ConverterCulture='de-DE', UpdateSourceTrigger=PropertyChanged}" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170" TextAlignment="Right" Typography.NumeralAlignment="Tabular">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="LostFocus">
                <i:InvokeCommandAction Command="{Binding NabavnaCijenaCommand}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label Content="Ostali troškovi" FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5"/>
          <TextBox Text="{Binding CurrentItemMat.Zavtro,                         Mode=TwoWay,                         UpdateSourceTrigger=PropertyChanged}" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170" TextAlignment="Right" Typography.NumeralAlignment="Tabular">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="LostFocus">
                <i:InvokeCommandAction Command="{Binding NabavnaCijenaCommand}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">NC</Label>
          <TextBox Text="{Binding CurrentItemMat.Nc, StringFormat=N9, TargetNullValue='0,00', ConverterCulture='de-DE', UpdateSourceTrigger=PropertyChanged}" FontSize="14" IsEnabled="False" VerticalAlignment="Center" MinHeight="30" Width="320" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
        </StackPanel>
      </WrapPanel>
      <Border Margin="0,14,0,0" Padding="0,18,0,0" BorderBrush="#E1E9ED" BorderThickness="0,1,0,0"><WrapPanel Margin="0">
        <Button Background="White" x:Name="btnSljedeci" FontSize="13" Command="{Binding NextButtonCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38">
          <Button.ToolTip>
            <ToolTip Content="Sljedeci"/>
          </Button.ToolTip>
          <TextBlock Text="&gt;" FontSize="24"/>
        </Button>
        <Button Background="White" x:Name="btnPrethodni" FontSize="13" Command="{Binding PrethodniButtonCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38">
          <Button.ToolTip>
            <ToolTip Content="Prethodni"/>
          </Button.ToolTip>
          <TextBlock Text="&lt;" FontSize="24"/>
        </Button>
        <Button x:Name="btnPrvi" Content="Prvi" FontSize="13" Command="{Binding PrviButtonCommand}" Margin="0,0,8,8" MinWidth="64" Padding="14,8" Height="38"/>
        <Button x:Name="btnZadnji" FontSize="13" Content="Zadnji" Command="{Binding ZadnjiButtonCommand}" Margin="0,0,8,8" MinWidth="64" Padding="14,8" Height="38"/>
        <Button x:Name="btnTrazi" Content="Traži" FontSize="13" Command="{Binding TraziSifruMaterijalaCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnNovaKalkulacija" Content="Nova kalkulacija" FontSize="13" Command="{Binding NovaKalkulacijaCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnSnimi" Content="Snimi" FontSize="13" Command="{Binding SpasiNovuKalkulacijuCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Style="{StaticResource FinancePrimaryButton}" Height="38"/>
        <Button x:Name="btnStampa1" Content="Štampa" FontSize="13" Command="{Binding PrintCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Style="{StaticResource FinancePrimaryButton}" Height="38"/>
        <Button x:Name="btnKrajFakture" Content="Kraj fakture" FontSize="13" Command="{Binding KrajFaktureCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnNovaStavka" Content="Nova stavka" FontSize="13" Command="{Binding NovaStavkaButtonCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnIzmjenaStavka" Content="Izmjena" Command="{Binding UpdateCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" FontSize="13" Height="38"/>
        <Button x:Name="btnSlijedecaStavka" Content="Slij. stavka" Command="{Binding SlijedecaStavkaCommand}" Focusable="True" IsTabStop="True" Margin="0,0,8,8" MinWidth="86" Padding="14,8" FontSize="13" Height="38"/>
        <Button x:Name="btnOdustani" Content="Odustani" Command="{Binding OdustaniCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" FontSize="13" Height="38"/>
        <Button x:Name="btnBrisanje" Content="Brisanje" Command="{Binding BrisanjeCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" FontSize="13" Style="{StaticResource FinanceDangerButton}" Height="38"/>
      </WrapPanel>
    </Border></StackPanel>
  </Border></ScrollViewer>
</UserControl>