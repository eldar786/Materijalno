<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:Materijalno.ViewModel;assembly=Materijalno.ViewModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Materijalno.UI" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" x:Class="Materijalno.UI.StanjeZalihaZaSvaSkladista" mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="1800">
    <UserControl.Resources>

        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Materijalno.UI;component/Themes/FinanceTheme.xaml"/></ResourceDictionary.MergedDictionaries><DataTemplate DataType="{x:Type vm:StanjeZalihaZaSvaSkladistaViewModel}">
            <local:StanjeZalihaZaSvaSkladista/>
        </DataTemplate>


        <!-- COLORS -->
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F1F5F7"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#087F82"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#06686C"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#07575C"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#203447"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#596D7E"/>

        <SolidColorBrush x:Key="BorderBrushLight" Color="#CDD8E0"/>


        <!-- LABEL -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FinanceLabel}">

            </Style>


        <!-- DATE PICKER -->
        <Style x:Key="FormDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource FinanceDatePicker}">

            <Setter Property="Height" Value="40"/>
            </Style>


        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FinancePrimaryButton}">

            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="40"/>
            </Style>

    </ResourceDictionary></UserControl.Resources>


    <Grid Background="{StaticResource PageBackgroundBrush}">

        <Grid.RowDefinitions>

            <!-- HEADER -->
            <RowDefinition Height="Auto"/>

            <!-- FORM -->
            <RowDefinition Height="Auto"/>

            <!-- EMPTY SPACE -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="24,18,24,18" HorizontalAlignment="Left">

            <TextBlock Text="PREGLED ZALIHA ZA SVA SKLADIŠTA" FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold" Foreground="#203447"/>

            <TextBlock Text="Odaberite datum za prikaz stanja zaliha svih skladišta" Margin="0,4,0,0" FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>

        </StackPanel>


        <!-- MAIN FORM CARD -->
        <Border Grid.Row="1" Width="650" HorizontalAlignment="Center" Padding="24" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="12">

            <Grid>

                <Grid.ColumnDefinitions>

                    <!-- LABEL -->
                    <ColumnDefinition Width="130"/>

                    <!-- DATE -->
                    <ColumnDefinition Width="180"/>

                    <!-- GAP -->
                    <ColumnDefinition Width="20"/>

                    <!-- BUTTON -->
                    <ColumnDefinition Width="130"/>

                    <!-- REMAINING SPACE -->
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- DO DATUMA -->
                <TextBlock Grid.Column="0" Text="Do datuma" Style="{StaticResource FormLabelStyle}"/>


                <DatePicker Grid.Column="1" SelectedDate="{Binding CurrentItemMat.Datun, Mode=TwoWay}" KeyDown="TextBox_KeyDown" Loaded="DatePicker_Loaded" Name="dtpOd" Style="{StaticResource FormDatePickerStyle}" VerticalAlignment="Center"/>


                <!-- ŠTAMPA -->
                <Button Grid.Column="3" x:Name="btnStampa" Content="Štampa" Click="stampa_button" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">

                    <Button.ToolTip>
                        <ToolTip Content="Print"/>
                    </Button.ToolTip>

                </Button>

                <Button Grid.Column="4" x:Name="btnFajl" Content="Fajl" Click="fajl_button"
                        Style="{StaticResource FinanceButton}" Width="110" Height="40" Margin="12,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        ToolTip="Snimi izvještaj u C:\zalihe\zalihesve.TXT"/>


            </Grid>

        </Border>

    </Grid>

</UserControl>
