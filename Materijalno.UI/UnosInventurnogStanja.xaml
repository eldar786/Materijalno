<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:vm="clr-namespace:Materijalno.ViewModel;assembly=Materijalno.ViewModel" xmlns:local="clr-namespace:Materijalno.UI" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" x:Class="Materijalno.UI.UnosInventurnogStanja" mc:Ignorable="d" d:DesignHeight="1000" d:DesignWidth="1900">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Materijalno.UI;component/Themes/FinanceTheme.xaml"/></ResourceDictionary.MergedDictionaries><DataTemplate DataType="{x:Type vm:UnosInventurnogStanjaViewModel}">
      <local:UnosInventurnogStanja/>
    </DataTemplate>
  </ResourceDictionary></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#F1F5F7">
    <Border Background="White" BorderBrush="#D7E1E7" BorderThickness="1" CornerRadius="10" Margin="20" Padding="20"><StackPanel Margin="0">
      <TextBlock Text="UNOS INVENTURNOG STANJA" Margin="0,0,0,16" FontSize="22" FontWeight="SemiBold" Foreground="#203447"/>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Skladište</Label>
          <TextBox Name="OpBroj" Text="{Binding CurrentItemInv.Kljnaz}" KeyDown="TextBox_KeyDown" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="LostFocus">
                <i:InvokeCommandAction Command="{Binding OsvjeziCommand}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </TextBox>
          <TextBox Text="{Binding CurrentItemTabSkladista.NazivOrg}" IsEnabled="False" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="320"/>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Šifra materijala</Label>
          <TextBox Text="{Binding CurrentItemInv.Ident}" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="LostFocus">
                <i:InvokeCommandAction Command="{Binding OsvjeziCommand}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </TextBox>
          <TextBox Text="{Binding CurrentItemTabMaterijala.Nazmat}" IsEnabled="False" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="320"/>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Jedinica mjere</Label>
          <TextBox Text="KOM" IsEnabled="False" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Konto 2</Label>
          <TextBox Text="{Binding CurrentItemTabMaterijalaK.Konto1}" KeyDown="TextBox_KeyDown" IsEnabled="False" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Konto 3</Label>
          <TextBox Text="{Binding CurrentItemTabMaterijalaK2.Konto2}" IsEnabled="False" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170"/>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Količina</Label>
          <TextBox Text="{Binding CurrentItemInv.Kolic, StringFormat=N2, TargetNullValue='0', ConverterCulture='de-DE', UpdateSourceTrigger=PropertyChanged}" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170" TextAlignment="Right" Typography.NumeralAlignment="Tabular">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="LostFocus">
                <i:InvokeCommandAction Command="{Binding NabavnaCijenaCommand}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">NC</Label>
          <TextBox Text="{Binding CurrentItemInv.Nc, StringFormat=N9, TargetNullValue='0,00', ConverterCulture='de-DE', UpdateSourceTrigger=PropertyChanged}" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Vrijednost</Label>
          <TextBox IsEnabled="False" Text="{Binding CurrentItemInv.Vrijed, StringFormat=N2, ConverterCulture='de-DE', TargetNullValue='0,00', UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="320" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Red. broj</Label>
          <TextBox Text="{Binding CurrentItemInv.Redbr}" IsEnabled="True" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
          <Label FontSize="13" VerticalAlignment="Center" Width="150" Padding="0,5,8,5">Ukupna vrijednost</Label>
          <TextBox IsEnabled="False" KeyDown="TextBox_KeyDown" FontSize="14" VerticalAlignment="Center" MinHeight="30" Width="170"/>
        </StackPanel>
      </WrapPanel>
      <Border Margin="0,14,0,0" Padding="0,18,0,0" BorderBrush="#E1E9ED" BorderThickness="0,1,0,0"><WrapPanel Margin="0">
        <Button x:Name="btnPrvi" Content="Prvi" FontSize="13" Command="{Binding PrviButtonCommand}" Margin="0,0,8,8" MinWidth="64" Padding="14,8" Height="38"/>
        <Button x:Name="btnZadnji" FontSize="13" Content="Zadnji" Command="{Binding ZadnjiButtonCommand}" Margin="0,0,8,8" MinWidth="64" Padding="14,8" Height="38"/>
        <Button x:Name="btnTrazi" Content="Traži" FontSize="13" Command="{Binding TraziSifruMaterijalaCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnNovaKalkulacija" Content="Novo skl." FontSize="13" Command="{Binding NovoSklCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnSnimi" Content="Snimi" FontSize="13" Command="{Binding SpasiNovuKalkulacijuCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Style="{StaticResource FinancePrimaryButton}" Height="38"/>
        <Button x:Name="btnStampa" Content="Štampa" FontSize="13" Command="{Binding StampaCommand}" Click="stampa_button" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Style="{StaticResource FinancePrimaryButton}" Height="38"/>
        <Button x:Name="btnPrethodni" Content="Prethodni" FontSize="13" Command="{Binding PrethodniButtonCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnSljedeci" FontSize="13" Content="Sljedeci" Command="{Binding NextButtonCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnNovaStavka" Content="Nova stavka" FontSize="13" Command="{Binding NovaStavkaCommand}" IsEnabled="False" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnIzmjena" Content="Izmjena" FontSize="13" Command="{Binding UpdateCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnSlijedecaStavka" Content="Slij. stavka" FontSize="13" Command="{Binding SlijStavkaButtonCommand}" IsEnabled="False" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnOdustani" Content="Odustani" FontSize="13" Command="{Binding OdustaniCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
        <Button x:Name="btnBrisanje" Content="Brisanje" FontSize="13" Command="{Binding BrisanjeCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Style="{StaticResource FinanceDangerButton}" Height="38"/>
      </WrapPanel>
    </Border></StackPanel>
  </Border></ScrollViewer>
</UserControl>