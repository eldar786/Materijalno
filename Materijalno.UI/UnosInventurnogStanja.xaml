<UserControl x:Class="Materijalno.UI.UnosInventurnogStanja"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:helpers="clr-namespace:Materijalno.UI.Helpers" Language="de-DE">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Materijalno.UI;component/Themes/FinanceTheme.xaml"/></ResourceDictionary.MergedDictionaries>
      <Style x:Key="InventoryInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Width" Value="170"/>
      </Style>
      <Style x:Key="InventoryLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13"/><Setter Property="Width" Value="150"/>
        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="0,5,8,5"/>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#F1F5F7">
    <Border Background="White" BorderBrush="#D7E1E7" BorderThickness="1" CornerRadius="10" Margin="20" Padding="20">
      <StackPanel>
        <TextBlock Text="UNOS INVENTURNOG STANJA" Margin="0,0,0,16" FontSize="22" FontWeight="SemiBold" Foreground="#203447"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <Label Content="Skladište" Style="{StaticResource InventoryLabel}"/>
          <TextBox x:Name="OpBroj" Text="{Binding CurrentItemInv.Kljnaz, ValidatesOnExceptions=True}" IsEnabled="{Binding IsWarehouseEditable}" Style="{StaticResource InventoryInput}" FontWeight="Bold" KeyDown="Input_KeyDown" LostKeyboardFocus="Reference_LostKeyboardFocus"/>
          <TextBox Text="{Binding CurrentItemTabSkladista.NazivOrg, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" FontSize="14" Width="320" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <Label Content="Šifra materijala" Style="{StaticResource InventoryLabel}"/>
          <TextBox x:Name="txtIdent" Text="{Binding CurrentItemInv.Ident}" IsEnabled="{Binding IsEntryEditable}" Style="{StaticResource InventoryInput}" MaxLength="9" KeyDown="Input_KeyDown" LostKeyboardFocus="Reference_LostKeyboardFocus"/>
          <TextBox Text="{Binding CurrentItemTabMaterijala.Nazmat, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" FontSize="14" Width="320" Margin="8,0,0,0"/>
        </StackPanel>
        <WrapPanel Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
            <Label Content="Jedinica mjere" Style="{StaticResource InventoryLabel}"/>
            <TextBox Text="{Binding CurrentItemTabMaterijala.Jedm, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" Style="{StaticResource InventoryInput}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
            <Label Content="Konto 2" Style="{StaticResource InventoryLabel}"/>
            <TextBox Text="{Binding CurrentItemTabMaterijala.Konto1, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" Style="{StaticResource InventoryInput}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
            <Label Content="Konto 3" Style="{StaticResource InventoryLabel}"/>
            <TextBox Text="{Binding CurrentItemTabMaterijala.Konto2, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" Style="{StaticResource InventoryInput}"/>
          </StackPanel>
        </WrapPanel>
        <WrapPanel Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
            <Label Content="Količina" Style="{StaticResource InventoryLabel}"/>
            <TextBox x:Name="txtKolic" Text="{Binding Kolicina, StringFormat=N2, ConverterCulture=de-DE, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" IsEnabled="{Binding IsEntryEditable}" helpers:QuantityInput.SelectAllOnFocus="True" Style="{StaticResource InventoryInput}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" KeyDown="Input_KeyDown" LostKeyboardFocus="Amount_LostKeyboardFocus"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
            <Label Content="NC" Style="{StaticResource InventoryLabel}"/>
            <TextBox x:Name="txtNc" Text="{Binding NabavnaCijenaUnos, StringFormat=N9, ConverterCulture=de-DE, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" IsEnabled="{Binding IsEntryEditable}" helpers:QuantityInput.SelectAllOnFocus="True" Style="{StaticResource InventoryInput}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" KeyDown="Input_KeyDown" LostKeyboardFocus="Amount_LostKeyboardFocus"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
            <Label Content="Vrijednost" Style="{StaticResource InventoryLabel}"/>
            <TextBox x:Name="txtVrijed" Text="{Binding Vrijednost, Mode=OneWay, StringFormat=N2, ConverterCulture=de-DE}" IsReadOnly="True" IsTabStop="False" Style="{StaticResource InventoryInput}" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
          </StackPanel>
        </WrapPanel>
        <WrapPanel Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
            <Label Content="Red. broj" Style="{StaticResource InventoryLabel}"/>
            <TextBox x:Name="txtRedbr" Text="{Binding CurrentItemInv.Redbr, ValidatesOnExceptions=True}" IsEnabled="{Binding IsEntryEditable}" Style="{StaticResource InventoryInput}" KeyDown="Input_KeyDown"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
            <Label Content="Ukupna vrijednost" Style="{StaticResource InventoryLabel}"/>
            <TextBox x:Name="txtUkupnaVrijednost" Text="{Binding UkupnaVrijednost, Mode=OneWay, StringFormat=N2, ConverterCulture=de-DE}" IsReadOnly="True" IsTabStop="False" Style="{StaticResource InventoryInput}" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
          </StackPanel>
        </WrapPanel>
        <Border Margin="0,14,0,0" Padding="0,18,0,0" BorderBrush="#E1E9ED" BorderThickness="0,1,0,0">
          <WrapPanel>
            <Button x:Name="btnPrvi" Content="Prvi" Command="{Binding PrviButtonCommand}" Margin="0,0,8,8" MinWidth="64" Padding="14,8" Height="38"/>
            <Button x:Name="btnZadnji" Content="Zadnji" Command="{Binding ZadnjiButtonCommand}" Margin="0,0,8,8" MinWidth="64" Padding="14,8" Height="38"/>
            <Button x:Name="btnTrazi" Content="Traži" Command="{Binding TraziSifruMaterijalaCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
            <Button x:Name="btnNovaKalkulacija" Content="Novo skl." Command="{Binding NovoSklCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
            <Button x:Name="btnSnimi" Content="Snimi" Command="{Binding SpasiNovuKalkulacijuCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38" Style="{StaticResource FinancePrimaryButton}"/>
            <Button x:Name="btnStampa" Content="Štampa" Command="{Binding PrintCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38" Style="{StaticResource FinancePrimaryButton}"/>
            <Button x:Name="btnPrethodni" Content="Prethodni" Command="{Binding PrethodniButtonCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
            <Button x:Name="btnSljedeci" Content="Sljedeci" Command="{Binding NextButtonCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
            <Button x:Name="btnNovaStavka" Content="Nova stavka" Command="{Binding NovaStavkaCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
            <Button x:Name="btnIzmjena" Content="Izmjena" Command="{Binding UpdateCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
            <Button x:Name="btnSlijedecaStavka" Content="Slij. stavka" Command="{Binding SlijStavkaButtonCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
            <Button x:Name="btnOdustani" Content="Odustani" Command="{Binding OdustaniCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
            <Button x:Name="btnBrisanje" Content="Brisanje" Command="{Binding BrisanjeCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38" Style="{StaticResource FinanceDangerButton}"/>
            <Button x:Name="btnIzlaz" Content="Izlaz" Command="{Binding IzlazCommand}" Margin="0,0,8,8" MinWidth="86" Padding="14,8" Height="38"/>
          </WrapPanel>
        </Border>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
