<Window x:Class="Materijalno.UI.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rv="clr-namespace:Microsoft.Reporting.WinForms;assembly=Microsoft.ReportViewer.WinForms"
        Title="Ulaz u magacin - od dobavljača" Height="820" Width="1040"
        WindowStartupLocation="CenterOwner" MinHeight="500" MinWidth="700">
    <DockPanel Background="#F4F7FB">
        <Button DockPanel.Dock="Top" Content="Zatvori" Click="Close_Click" IsCancel="True"
                HorizontalAlignment="Right" Width="100" Height="36" Margin="10"/>
        <WindowsFormsHost Margin="10,0,10,10">
            <rv:ReportViewer x:Name="_reportViewer"/>
        </WindowsFormsHost>
    </DockPanel>
</Window>
