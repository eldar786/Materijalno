<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:vm="clr-namespace:Materijalno.ViewModel;assembly=Materijalno.ViewModel" xmlns:local="clr-namespace:Materijalno.UI" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" x:Class="Materijalno.UI.StampanjeInventurnihListica" mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="1900">

    <UserControl.Resources>

        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Materijalno.UI;component/Themes/FinanceTheme.xaml"/></ResourceDictionary.MergedDictionaries><DataTemplate DataType="{x:Type vm:StampanjeInventurnihListicaViewModel}">
            <local:StampanjeInventurnihListica/>
        </DataTemplate>


        <!-- COLORS -->
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F1F5F7"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#087F82"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#06686C"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#07575C"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#203447"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#596D7E"/>

        <SolidColorBrush x:Key="BorderBrushLight" Color="#CDD8E0"/>
        <SolidColorBrush x:Key="ReadOnlyBackgroundBrush" Color="#F8FAFC"/>


        <!-- LABEL -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FinanceLabel}">

            </Style>


        <!-- TEXTBOX -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FinanceTextBox}">

            <Setter Property="Height" Value="40"/>
            </Style>


        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FinancePrimaryButton}">

            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="40"/>

            </Style>

    </ResourceDictionary></UserControl.Resources>



    <Grid Background="{StaticResource PageBackgroundBrush}">

        <Grid.RowDefinitions>

            <!-- HEADER -->
            <RowDefinition Height="Auto"/>

            <!-- FORM -->
            <RowDefinition Height="Auto"/>

            <!-- EMPTY SPACE -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- ====================================================== -->
        <!-- HEADER -->
        <!-- ====================================================== -->

        <StackPanel Grid.Row="0" Margin="24,18,24,18" HorizontalAlignment="Left">

            <TextBlock Text="ŠTAMPANJE INVENTURNIH LISTICA" FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold" Foreground="#203447"/>


            <TextBlock Text="Odaberite skladište za štampanje inventurnih listica" Margin="0,4,0,0" FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>

        </StackPanel>



        <!-- ====================================================== -->
        <!-- MAIN FORM CARD -->
        <!-- ====================================================== -->

        <Border Grid.Row="1" Width="650" HorizontalAlignment="Center" Padding="24" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="12">

            <Grid>

                <Grid.ColumnDefinitions>

                    <!-- LABEL -->
                    <ColumnDefinition Width="110"/>

                    <!-- ŠIFRA SKLADIŠTA -->
                    <ColumnDefinition Width="150"/>

                    <!-- GAP -->
                    <ColumnDefinition Width="16"/>

                    <!-- NAZIV SKLADIŠTA -->
                    <ColumnDefinition Width="*"/>

                    <!-- GAP -->
                    <ColumnDefinition Width="16"/>

                    <!-- ŠTAMPA -->
                    <ColumnDefinition Width="100"/>

                </Grid.ColumnDefinitions>



                <!-- ================================================== -->
                <!-- SKLADIŠTE -->
                <!-- ================================================== -->

                <TextBlock Grid.Column="0" Text="Skladište" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>



                <!-- ŠIFRA SKLADIŠTA -->
                <TextBox Grid.Column="1" Text="{Binding CurrentItemMat.Kljnaz}" KeyDown="TextBox_KeyDown" Style="{StaticResource FormTextBoxStyle}">

                    <i:Interaction.Triggers>

                        <i:EventTrigger EventName="LostFocus">

                            <i:InvokeCommandAction Command="{Binding OsvjeziCommand}"/>

                        </i:EventTrigger>

                    </i:Interaction.Triggers>

                </TextBox>



                <!-- NAZIV SKLADIŠTA -->
                <TextBox Grid.Column="3" Text="{Binding CurrentItemTabSkladista.NazivOrg, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Style="{StaticResource FormTextBoxStyle}"/>



                <!-- ================================================== -->
                <!-- ŠTAMPA -->
                <!-- ================================================== -->

                <Button Grid.Column="5" x:Name="btnFormiraj" Content="Štampa" Click="stampa_button" Visibility="{Binding Path=VidljivoOdabirVrsteIncidenta}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>