<UserControl x:Class="Materijalno.UI.SifarnikMaterijalSkladisteKonto"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Materijalno.ViewModel;assembly=Materijalno.ViewModel"
             xmlns:local="clr-namespace:Materijalno.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="900">

    <UserControl.Resources>

        <DataTemplate DataType="{x:Type vm:SifarnikMaterijalSkladisteKontoViewModel}">
            <local:SifarnikMaterijalSkladisteKonto/>
        </DataTemplate>


        <!-- COLORS -->
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E40AF"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#EEF5FF"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085"/>

        <SolidColorBrush x:Key="BorderBrushLight" Color="#E4E7EC"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#F7FAFC"/>

        <SolidColorBrush x:Key="DangerLightBrush" Color="#FFF1F1"/>
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#F0B4B4"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>


        <!-- NORMAL ACTION BUTTON -->
        <Style x:Key="ActionButtonStyle"
           TargetType="Button">

            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#F2F6FC"/>

                                <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#98A2B3"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#E8EEF7"/>

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter Property="Opacity"
                                    Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- DELETE BUTTON -->
        <Style x:Key="DeleteActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ActionButtonStyle}">

            <Setter Property="BorderBrush"
                Value="{StaticResource DangerBorderBrush}"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="DeleteBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="DeleteBorder"
                                    Property="Background"
                                    Value="{StaticResource DangerLightBrush}"/>

                                <Setter TargetName="DeleteBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource DangerBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="DeleteBorder"
                                    Property="Background"
                                    Value="#FFE4E4"/>

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter Property="Opacity"
                                    Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- PRIMARY ADD BUTTON -->
        <Style x:Key="PrimaryActionButtonStyle"
           TargetType="Button">

            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background"
                Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="PrimaryBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter TargetName="PrimaryBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimaryHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter TargetName="PrimaryBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimaryPressedBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                 Value="False">

                                <Setter Property="Opacity"
                                    Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- EDIT BUTTON INSIDE TABLE -->
        <Style x:Key="TableIconButtonStyle"
           TargetType="Button">

            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="TableButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter TargetName="TableButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimaryLightBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter TargetName="TableButtonBorder"
                                    Property="Background"
                                    Value="#DCE9FF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- GRIDVIEW HEADER -->
        <Style TargetType="{x:Type GridViewColumnHeader}">

            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>

            <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrushLight}"/>

            <Setter Property="BorderThickness"
                Value="0,0,1,1"/>

            <Setter Property="HorizontalContentAlignment"
                Value="Left"/>

            <Setter Property="Padding"
                Value="14,0"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">

                        <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </UserControl.Resources>


    <Grid Background="{StaticResource PageBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <Grid Grid.Row="0"
          Margin="30,24,30,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">

                <TextBlock
                Text="ŠIFARNIK MATERIJAL - SKLADIŠTE - KONTO"
                FontFamily="Segoe UI"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock
                Text="Pregled i upravljanje vezama materijala, skladišta i konta"
                Margin="0,4,0,0"
                FontFamily="Segoe UI"
                FontSize="12.5"
                Foreground="{StaticResource TextSecondaryBrush}"/>

            </StackPanel>


            <!-- PRINT -->
            <Button
            Grid.Column="1"
            x:Name="btnStampa"
            Style="{StaticResource ActionButtonStyle}"
            Click="stampa_button"
            VerticalAlignment="Center">

                <Image
                Source="/Ikone/printer.png"
                Width="22"
                Height="22"
                Stretch="Uniform"/>

                <Button.ToolTip>
                    <ToolTip Content="Print"/>
                </Button.ToolTip>

            </Button>

        </Grid>


        <!-- TABLE CARD -->
        <Border
        Grid.Row="1"
        Margin="30,0,30,0"
        Background="{StaticResource CardBackgroundBrush}"
        BorderBrush="{StaticResource BorderBrushLight}"
        BorderThickness="1"
        CornerRadius="10"
        SnapsToDevicePixels="True">

            <ListView
            Name="GrKomitenti"
            ItemsSource="{Binding SifarnikMaterijalSkladisteKontoList}"
            SelectedValue="{Binding SelectedSifarnikMaterijalSkladisteKonto}"
            Background="White"
            BorderThickness="0"
            FontFamily="Segoe UI"
            FontSize="15"
            Foreground="{StaticResource TextPrimaryBrush}"
            HorizontalContentAlignment="Stretch"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto">


                <!-- ROW STYLE -->
                <ListView.ItemContainerStyle>

                    <Style TargetType="ListViewItem">

                        <Setter Property="HorizontalContentAlignment"
                            Value="Stretch"/>

                        <Setter Property="VerticalContentAlignment"
                            Value="Center"/>

                        <Setter Property="Padding"
                            Value="0"/>

                        <Setter Property="Margin"
                            Value="0"/>

                        <Setter Property="MinHeight"
                            Value="46"/>

                        <Setter Property="Background"
                            Value="White"/>

                        <Setter Property="BorderBrush"
                            Value="#EEF1F4"/>

                        <Setter Property="BorderThickness"
                            Value="0,0,0,1"/>


                        <Setter Property="Template">
                            <Setter.Value>

                                <ControlTemplate TargetType="ListViewItem">

                                    <Border
                                    x:Name="RowBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">

                                        <GridViewRowPresenter
                                        Content="{TemplateBinding Content}"
                                        Columns="{TemplateBinding GridView.ColumnCollection}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"/>

                                    </Border>


                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver"
                                             Value="True">

                                            <Setter
                                            TargetName="RowBorder"
                                            Property="Background"
                                            Value="{StaticResource HoverBrush}"/>

                                        </Trigger>


                                        <Trigger Property="IsSelected"
                                             Value="True">

                                            <Setter
                                            TargetName="RowBorder"
                                            Property="Background"
                                            Value="{StaticResource PrimaryLightBrush}"/>

                                            <Setter
                                            Property="Foreground"
                                            Value="{StaticResource PrimaryBrush}"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Setter.Value>
                        </Setter>

                    </Style>

                </ListView.ItemContainerStyle>


                <!-- COLUMNS -->
                <ListView.View>

                    <GridView>


                        <!-- EDIT BUTTON -->
                        <GridViewColumn Width="60">

                            <GridViewColumn.CellTemplate>

                                <DataTemplate>

                                    <Button
                                    Style="{StaticResource TableIconButtonStyle}"
                                    Command="{Binding DataContext.IzmjenaSifarnikMaterijalSkladisteKontoFormCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                    HorizontalAlignment="Center">

                                        <Image
                                        Source="/Ikone/uredi3.png"
                                        Width="20"
                                        Height="20"
                                        Stretch="Uniform"/>

                                        <Button.ToolTip>
                                            <ToolTip Content="Uredi"/>
                                        </Button.ToolTip>

                                    </Button>

                                </DataTemplate>

                            </GridViewColumn.CellTemplate>

                        </GridViewColumn>


                        <GridViewColumn
                        Header="Šifra materijala"
                        DisplayMemberBinding="{Binding Sifmat}"
                        Width="220"/>


                        <GridViewColumn
                        Header="Šifra skladišta"
                        DisplayMemberBinding="{Binding Sifskla}"
                        Width="260"/>


                        <GridViewColumn
                        Header="Šifra konta"
                        DisplayMemberBinding="{Binding Sifkonta}"
                        Width="240"/>


                    </GridView>

                </ListView.View>

            </ListView>

        </Border>


        <!-- BOTTOM ACTION BUTTONS -->
        <Grid
        Grid.Row="2"
        Margin="30,14,30,24">

            <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right">


                <!-- EDIT -->
                <Button
                x:Name="btnIzmjena"
                Command="{Binding IzmjenaSifarnikMaterijalSkladisteKontoFormCommand}"
                Style="{StaticResource ActionButtonStyle}"
                Margin="0,0,10,0">

                    <Image
                    Source="/Ikone/uredi3.png"
                    Width="22"
                    Height="22"
                    Stretch="Uniform"/>

                    <Button.ToolTip>
                        <ToolTip Content="Uredi"/>
                    </Button.ToolTip>

                </Button>


                <!-- DELETE -->
                <Button
                x:Name="btnBrisanje"
                Command="{Binding DeleteSifarnikMaterijalSkladisteKontoCommand}"
                Style="{StaticResource DeleteActionButtonStyle}"
                Margin="0,0,10,0">

                    <Image
                    Source="/Ikone/obrisi.png"
                    Width="22"
                    Height="22"
                    Stretch="Uniform"/>

                    <Button.ToolTip>
                        <ToolTip Content="Obriši"/>
                    </Button.ToolTip>

                </Button>


                <!-- ADD -->
                <Button
                x:Name="btnUnos"
                Command="{Binding OpenSifarnikMaterijalSkladisteKontoFormCommand,
                                  Mode=TwoWay,
                                  UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource PrimaryActionButtonStyle}">

                    <Image
                    Source="/Ikone/dodaj.png"
                    Width="22"
                    Height="22"
                    Stretch="Uniform"/>

                    <Button.ToolTip>
                        <ToolTip Content="Dodaj"/>
                    </Button.ToolTip>

                </Button>


            </StackPanel>

        </Grid>

    </Grid>

</UserControl>