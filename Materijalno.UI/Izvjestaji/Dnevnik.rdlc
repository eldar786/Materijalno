                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIF(
    Fields!Vrijed.Value &gt; 0,
    IIF(
        IsNothing(Fields!Vrijed.Value),
        0,
        Fields!Vrijed.Value
    ),
    0
)</Value>
                              <Style>
                                <Format>n2</Format>
                                <Language>bs-Latn-BA</Language>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
