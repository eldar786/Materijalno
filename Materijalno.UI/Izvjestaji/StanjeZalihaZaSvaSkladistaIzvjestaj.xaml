<Window x:Class="Materijalno.UI.Izvjestaji.StanjeZalihaZaSvaSkladistaIzvjestaj"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Materijalno.UI.Izvjestaji"
        mc:Ignorable="d" xmlns:rv="clr-namespace:Microsoft.Reporting.WinForms;assembly=Microsoft.ReportViewer.WinForms" 
        Title="Stanje Zaliha Za Sva Skladista Izvjestaj" Height="600" Width="600" WindowState="Maximized">
    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="10,5,10,0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <DatePicker Height="25" HorizontalAlignment="Left" Margin="7,8,0,0" Name="txtDat" VerticalAlignment="Top" Width="115" Visibility="Hidden" Grid.Row="0" Grid.Column="0" />
            <Button Name="btnOdustani" Width="100" HorizontalAlignment="Right" Visibility="{Binding Path=OdustaniVisible}"  IsCancel="True" Margin="0,0,5,0" Click="btnOdustani_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">Zatvori</TextBlock>
                </StackPanel>
            </Button>
        </Grid>
        <WindowsFormsHost Name="windowsFormsHost1" Margin="10,-38,10,10">
            <rv:ReportViewer x:Name="_reportViewer"/>
        </WindowsFormsHost>
    </DockPanel>
</Window>

