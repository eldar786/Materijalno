<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Materijalno.UI.PregledUlazaPoKontimaiKalkulacijama">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Materijalno.UI;component/Themes/FinanceTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources><Grid Background="#F1F5F7"><StackPanel Width="650" Margin="30" VerticalAlignment="Top">
 <TextBlock Text="Ulazi po kontima i kalkulacijama" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,25" Foreground="#203447"/>
 <WrapPanel Margin="0,8"><TextBlock Text="Od datuma" Width="100" VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding Od}" Width="150"/><TextBlock Text="Do datuma" Margin="24,0,8,0" VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding Do}" Width="150"/></WrapPanel>


 <WrapPanel Margin="0,24"><Button Content="Pregled i štampa" Command="{Binding StampaCommand}" Padding="18,9" Style="{StaticResource FinancePrimaryButton}"/><Button Content="Izlaz" Command="{Binding CancelSifarnikSkladistaCommand}" Margin="15,0" Padding="18,9"/></WrapPanel>
 </StackPanel></Grid></UserControl>