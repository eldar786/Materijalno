<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Materijalno.ViewModel;assembly=Materijalno.ViewModel" xmlns:local="clr-namespace:Materijalno.UI" x:Class="Materijalno.UI.CentralniMagacin">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Materijalno.UI;component/Themes/FinanceTheme.xaml"/></ResourceDictionary.MergedDictionaries><DataTemplate DataType="{x:Type vm:CentralniMagacinViewModel}"><local:CentralniMagacin/></DataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="#F1F5F7">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="24,20,24,16">
   <TextBlock Text="ULAZ U CENTRALNI MAGAZIN – FINANSIJSKI NALOG" FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold" Foreground="#203447" TextWrapping="Wrap"/>
   <TextBlock Text="Unesite broj kalkulacije za formiranje finansijskog naloga." FontFamily="Segoe UI" FontSize="12.5" Foreground="#596D7E" Margin="0,6,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Width="650" Padding="24" Margin="24,0,24,24" VerticalAlignment="Top" HorizontalAlignment="Center" Background="White" BorderBrush="#CDD8E0" BorderThickness="1" CornerRadius="12">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
    <TextBlock Text="Broj kalkulacije" FontFamily="Segoe UI" FontSize="14" VerticalAlignment="Center"/>
    <TextBox x:Name="txtBrojKalkulacije" Grid.Column="1" Text="{Binding BrojMedjuskladisnice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="40" FontFamily="Segoe UI" FontSize="14" Padding="12,4" BorderBrush="#CDD8E0" BorderThickness="1" VerticalContentAlignment="Center"/>
    <Button x:Name="btnFormiraj" Grid.Column="3" Content="Formiraj" Command="{Binding FormirajCommand}" Height="40" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Background="#087F82" Foreground="White" BorderThickness="0" Cursor="Hand" Style="{StaticResource FinancePrimaryButton}"/>
   </Grid>
  </Border>
 </Grid>
</UserControl>